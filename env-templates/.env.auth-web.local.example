# 로컬 전체 스택용 auth-web (:8001). 절차: docs/local-dev.md
USER_SERVICE_URL=http://localhost:3000

# localhost 는 https 가 아니므로 Secure 쿠키를 쓰면 세션이 저장되지 않는다.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# redirect_to 허용 호스트. authorize 후 자기 자신으로 복귀하므로 8001 도 필요.
# 🔴 127.0.0.1 도 있어야 한다. 어드민을 127.0.0.1 로 분리하면 redirect_to 가 그 호스트로 온다.
# 빠뜨리면 sanitizeRedirectTo(lib/redirect.ts)가 null 을 주고 콜백이 localhost 로 떨어져
# /login?error=state_cookie_missing 무한 루프가 된다 (§6-①).
ALLOWED_REDIRECT_HOSTS=localhost:8000,localhost:8001,localhost:8002,localhost:3200,localhost:9000,127.0.0.1:8000,127.0.0.1:8001,127.0.0.1:8002,127.0.0.1:3200,127.0.0.1:9000
AUTH_WEB_ORIGIN=http://localhost:8001

# user-service 의 OAUTH_INTERNAL_SECRET 과 반드시 같은 값
OAUTH_INTERNAL_SECRET=local-oauth-internal-secret
