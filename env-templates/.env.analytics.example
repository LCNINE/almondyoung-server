DATABASE_URL=

KAFKA_BROKERS="${{shared.KAFKA_BROKERS}}"
KAFKA_API_KEY="${{shared.KAFKA_API_KEY}}"
KAFKA_API_SECRET="${{shared.KAFKA_API_SECRET}}"
KAFKA_CLIENT_ID_PREFIX="analytics"
KAFKA_GROUP_ID="analytics-group"

RAILWAY_DOCKERFILE_PATH="apps/analytics/Dockerfile"

OTEL_SERVICE_NAME=analytics
OTEL_EXPORTER_OTLP_ENDPOINT=

# 역할별 권한 사본(user-service 내부 경로). 키는 apps/user-service/.env 의 USER_SERVICE_INTERNAL_KEY 와 같은 값.
USER_SERVICE_URL=http://localhost:3000
USER_SERVICE_INTERNAL_KEY=local-user-service-internal-key
