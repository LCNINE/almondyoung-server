# 로컬 개발 전용. 절차: docs/local-dev.md

ALMONDYOUNG_API_URL=http://localhost:3100
FILE_SERVICE_URL=http://localhost:3010
# 없으면 적립금 화면이 조용히 죽는다 — 통계 4칸이 전부 0 으로 «그려진다».
WALLET_SERVICE_URL=http://localhost:5001

# 페이지 미들웨어/RouteGuard 우회. user-service·auth-web·OIDC 없이 화면을 연다.
# 브라우저 쿠키 accessToken 에 심어둔 HS256 토큰은 프록시가 그대로 업스트림에 넘기므로
# core/file-service 의 인가는 **여전히 실제로 동작한다**(middleware.ts:58, forward.ts:56).
# MSW 로 화면만 볼 때는 true. 🔴 전 과정(E2E) 검증에서는 «false» 로 둔다 —
# true 면 세션이 일반 사용자로 강등돼도 로그인 화면으로 안 내쫓고 모든 API 만 403 이 된다.
BYPASS_AUTH=true

# /login 은 이 구성에서 도달할 일이 없지만, 401 이 한 번이라도 나면 클라이언트가
# 그리로 push 한다(client.ts:139 → auth-expired-handler). 그때 lib/auth/env.ts 가
# 이 값들을 required() 로 읽어 **500 페이지**가 뜨고, 새로고침해도 안 빠져나온다.
# 실제 로그인은 하지 않으므로 값은 자리채움이면 된다 — 500 대신 죽은 링크가 된다.
OIDC_ISSUER_URL=http://localhost:3000
# 🔴 아래 셋은 «127.0.0.1» 이다. 오타가 아니다.
# 쿠키는 포트는 안 가려도 «호스트»는 가린다. 어드민을 127.0.0.1 로, 고객(스토어프론트)을
# localhost 로 열면 한 브라우저에서 두 세션이 동시에 산다. localhost 로 두면 고객 로그인이
# 어드민 세션을 덮고, 반대로 어드민 로그인이 고객 세션을 덮는다 (§6-①).
# AUTHORIZATION_URL 까지 옮겨야 «로그인 행위» 자체가 오염을 안 일으킨다.
# 짝: web/auth-web 의 ALLOWED_REDIRECT_HOSTS 에 127.0.0.1:8001,127.0.0.1:8002 가 있어야 한다.
OIDC_AUTHORIZATION_URL=http://127.0.0.1:8001/oauth/authorize
OIDC_CLIENT_ID=admin-web
OIDC_CLIENT_SECRET=local-rehearsal-medusa-storefront-secret
OIDC_REDIRECT_URI=http://127.0.0.1:8002/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:8002/login
OAUTH_JWKS_URL=http://localhost:3000/.well-known/jwks.json
OAUTH_ISSUER_URL=http://localhost:3000
USER_SERVICE_URL=http://localhost:3000

# === 쿠폰 개통 리허설 1차 (2026-08-30) 추가. 절차: docs/coupon-rehearsal-local-env.md ===
# 로컬 Medusa(:9000). /api/proxy/medusa 가 secret API key 를 Basic 으로 붙여 넘긴다.
MEDUSA_API_URL=http://localhost:9000
MEDUSA_API_KEY=<sk_… Medusa 관리자 API 키. 절차는 docs/local-dev.md>
