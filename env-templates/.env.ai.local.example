# ai 앱 — AI 어시스턴트(도구 호출 채팅) + 상품 상세설명 초안.
# 다른 서비스는 전부 HTTP 로 부른다. 인증은 부른 사람의 쿠키/토큰을 그대로 전달한다.

PORT=3070

# ai 전용 논리 DB. bootstrap 이 만들고 migrate 가 적용한다.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai

# admin-web 이 넘겨 준 토큰을 검증한다. 둘 중 하나는 반드시 있어야 부팅한다.
AUTH_SECRET=
OIDC_ISSUER_URL=http://localhost:3000
JWT_ISSUER=almondyoung-auth

# 도구가 부르는 곳.
CORE_API_URL=http://localhost:3100
FILE_SERVICE_URL=http://localhost:3010

# 어시스턴트(챗봇)용. 없으면 채팅이 503 을 낸다.
# 검색 임베딩용 키와는 다른 키다.
OPENAI_API_KEY=<OpenAI API key>

# 상품 상세설명 초안용. 없으면 그 기능만 503 이다.
ANTHROPIC_API_KEY=<Anthropic API key>

# 어시스턴트 모델. 도구를 여러 번 도는 작업이라 출력 단가가 비싸면 그 배수만큼 곱해진다.
ASSISTANT_MODEL=gpt-5

# 1M 토큰당 USD. developers.openai.com/api/docs/pricing 에서 읽어 채운다.
# 비우면 로그에 토큰 수만 찍히고 금액은 생략된다 — 모르는 것과 0원인 것은 다르다.
OPENAI_PRICE_INPUT_PER_MTOK=
OPENAI_PRICE_CACHED_INPUT_PER_MTOK=
OPENAI_PRICE_OUTPUT_PER_MTOK=

# 대화 접기. 이 크기를 넘으면 오래된 턴을 요약으로 대체한다.
# 대화는 매 턴 통째로 다시 실리므로, 접지 않으면 입력 토큰이 턴 수에 비례해 는다.
ASSISTANT_COMPACT_THRESHOLD_TOKENS=12000
ASSISTANT_COMPACT_KEEP_RECENT=6
ASSISTANT_COMPACT_MODEL=gpt-5-mini

OTEL_SERVICE_NAME=ai
OTEL_EXPORTER_OTLP_ENDPOINT=

# 탈퇴 회원 대화 파기용(소비 전용). 비우면 컨슈머를 안 띄운다 — 부팅은 정상이다.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID_PREFIX=ai
KAFKA_GROUP_ID=ai-local
