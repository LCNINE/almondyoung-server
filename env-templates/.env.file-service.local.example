# 로컬 file-service (:3010) — apps/file-service/.env 로 복사한다.
# 상품 이미지 업로드가 이 앱을 탄다. 없으면 일괄등록·상품등록에서 이미지가 조용히 안 올라간다.

PORT=3010
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/file_service

# 🔴 core 의 AUTH_SECRET 과 «같은 값»이어야 한다 — core 가 자기 AUTH_SECRET 으로 서명한 위임
# 토큰을 file-service 가 검증한다
# (catalog/operations/bulk-session/services/form-export-file.client.ts:51).
# 어긋나면 양식 내보내기·이미지 업로드가 401 인데, 화면엔 그냥 실패로만 보인다.
AUTH_SECRET=<로컬 전용 임의값 — apps/core/.env 의 AUTH_SECRET 과 동일하게>

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID_PREFIX=file-service-local
KAFKA_GROUP_ID=file-service-local

# S3 를 타지 않는다. 파일은 <cwd>/uploads 에 쌓이고 GET /files/local/* 로 되읽는다.
STORAGE_PROVIDER=LOCAL
