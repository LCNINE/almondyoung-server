# 로컬 channel-adapter(:3003) 템플릿. apps/channel-adapter/.env 로 복사한다.
# (같은 디렉터리의 .env.channel-adapter.example 은 «배포용» 이다 — Railway 변수 참조가 들어 있다)
#
# 이 앱이 주문 수집을 돈다. 아래 셋 중 하나라도 비면 수집이 «조용히» 멈춘다 —
# 스토어프론트에서 주문을 만들어도 core sales_orders 에 영영 안 들어오고,
# 어드민 주문조회는 그냥 「0건」이다. (docs/local-e2e-environment.md §8-B)

# 🔴 3003 이다. 3010 이 아니다 — file-service 가 3010 을 쓴다.
# 둘 다 3010 이면 먼저 뜬 쪽이 이기고 다른 쪽은 조용히 죽는다. 그러면 admin-web 의
# FILE_SERVICE_URL=3010 이 channel-adapter 로 가서 상품 이미지 업로드가 엉뚱한 앱에 닿는다.
# 메트릭 포트는 PORT+10000 = 13003 으로 따라간다.
PORT=3003

NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/channel_adapter

# 로컬 compose 브로커. 🔴 kafka 없이 부팅하면 «죽는다» — 경고가 아니라 KafkaJSNonRetriableError.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID_PREFIX=channel-adapter-local
KAFKA_GROUP_ID=channel-adapter-local-<사용자>

# --- 주문 수집 게이트 (셋 다 필요하다) ---

# ① core(:3100) 내부 API 키. apps/core/.env 의 «같은 이름 값과 일치» 해야 한다.
#    없으면: 「활성 판매채널 조회에 실패해 이번 주기의 모든 채널을 건너뛴다」
CORE_INTERNAL_KEY=<로컬 전용 임의값 — core 와 같은 값>

# ② 🔴 기본값이 http://localhost:3001 인데 그건 «membership» 포트다(sales-channel.client.ts:27).
#    명시하지 않으면 엉뚱한 서비스에 판매채널을 물어본다. core 는 3100.
PIM_API_URL=http://localhost:3100

# ③ (env 아님) core DB 에 site='medusa' 활성 sales_channels 행 1개.
#    정본 시드가 있다: npm run db:seed:core:local

MEDUSA_API_URL=http://localhost:9000
MEDUSA_API_KEY=<apps/medusa 의 secret API key>

OIDC_ISSUER_URL=http://localhost:3000
