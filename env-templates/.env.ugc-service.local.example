# 로컬 ugc-service (:3030) — apps/ugc-service/.env 로 복사한다.
# 리뷰·Q&A·샵 매매. storefront(backend.ts)와 admin-web(/api/proxy/ugc)이 여기 온다.

PORT=3030

# ugc 전용 논리 DB. bootstrap 이 만들고(init-db.sql) migrate 가 적용한다.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ugc

# 토큰 검증. 둘 다 둔다 — 회원·관리자 토큰은 RS256(OIDC), 서버 간 위임은 HS256.
AUTH_SECRET=<로컬 전용 임의값 — apps/core/.env 의 AUTH_SECRET 과 동일하게>
OIDC_ISSUER_URL=http://localhost:3000

# 🔴 필수다. 리뷰 적립 명령 아웃박스(EventsModule.forApp)가 부팅 시 Kafka 설정을 요구해,
# 비우면 «부팅하다 죽는다». 브로커는 bootstrap:e2e:local 이 띄운다.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID_PREFIX=ugc-service-local
KAFKA_GROUP_ID=ugc-service-local

# 아몬드템플릿의 파일 조회·검증에 사용한다.
FILE_SERVICE_URL=http://localhost:3010
FILE_SERVICE_INTERNAL_KEY=

# medusa 가 주문 완료 때 리뷰 자격을 만들러 부르는 /internal/* 키. 비우면 그 라우트는 전부 401
# (fail-closed) — 로컬에서 리뷰를 쓰려면 apps/medusa/.env 의 UGC_INTERNAL_KEY 와 같은 값으로 채운다.
UGC_INTERNAL_KEY=

OTEL_SERVICE_NAME=ugc-service
OTEL_EXPORTER_OTLP_ENDPOINT=

# 역할별 권한 사본(user-service 내부 경로). 키는 apps/user-service/.env 의 USER_SERVICE_INTERNAL_KEY 와 같은 값.
USER_SERVICE_URL=http://localhost:3000
USER_SERVICE_INTERNAL_KEY=local-user-service-internal-key

# 테넌트 목록·전환 모드 (@app/tenancy). 정본은 scripts/local/e2e-env-map.sh — 없거나 틀리면 앱이 뜨지 않는다.
TENANT_LIST='[{"id":"1","slug":"almondyoung","coreDb":"dev_core","publicBucket":"almondyoung-demo","privateBucket":"almondyoung-demo"}]'
TENANT_GATE_MODE=warn
# 앱 설정 T — 직접 발행·outbox 의 봉투 테넌트 (정본: scripts/local/e2e-env-map.sh E2E_SERVED_TENANT_ID)
SERVED_TENANT_ID=1
