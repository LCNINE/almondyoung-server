# 로컬 쿠폰 개통 리허설용. 절차: docs/coupon-rehearsal-local-env.md
# 인프라는 루트 docker-compose.yml (postgres/redis/kafka). 포트 배치는 docs/local-dev.md.
NODE_ENV=development
MEDUSA_ADMIN_ONBOARDING_TYPE=default

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medusa
REDIS_URL=redis://localhost:6379

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:8002
AUTH_CORS=http://localhost:9000,http://localhost:8000,http://localhost:8001,http://localhost:8002

JWT_SECRET=local-rehearsal-jwt-secret
COOKIE_SECRET=local-rehearsal-cookie-secret
JWT_EXPIRES_IN=30d

FRONTEND_URL=http://localhost:8000
MEDUSA_BACKEND_URL=http://localhost:9000

# Kafka — 루트 compose 브로커로 격리 (라이브 Confluent 자격증명 없음)
KAFKA_CLIENT_ID_PREFIX=medusa-service-local
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=medusa-consumer-local
KAFKAJS_NO_PARTITIONER_WARNING=1

# 결제 — 로컬 wallet(5001). 리허설 R1 의 주문 완료에만 필요.
WALLET_BASE_URL=http://localhost:5001
WALLET_API_KEY=dev-secret
ALMOND_PAYMENT_ENDPOINT=http://localhost:5001

# === OIDC (user-service-sso) — 로컬 IdP ===
# AUTH_WEB_URL 이 truthy 여야 provider 가 등록된다. 그 순간 customer 인증이
# user-service-sso 하나로 좁혀진다 (medusa-config.js: authMethodsPerActor) — emailpass 는 admin 전용이 된다.
AUTH_WEB_URL=http://localhost:8001
OIDC_ISSUER_URL=http://localhost:3000
USER_SERVICE_URL=http://localhost:3000
OIDC_CLIENT_ID=medusa-storefront
# user-service oauth_clients.medusa-storefront 의 bcrypt 해시와 짝. 시드는 npm run seed:oauth-clients.
OIDC_CLIENT_SECRET=local-rehearsal-medusa-storefront-secret
OIDC_SCOPES=openid email profile
SSO_DEFAULT_CALLBACK_URL=http://localhost:8000/kr/callback/oidc
