# membership 로컬 E2E 용. apps/membership/.env 로 복사한다.
# (.env.membership.example 은 배포용이라 PORT·OIDC_ISSUER_URL·MEMBERSHIP_INTERNAL_KEY 가 없다 —
#  그대로 쓰면 3001 이 아닌 기본 포트로 뜨고 어드민 호출이 전부 401 이 된다.)

DATABASE_URL=postgres://postgres:postgres@localhost:5432/membership
PORT=3001
NODE_ENV=development

# 🔴 EventsModule.forApp 이 kafka 설정을 역참조하므로 값이 없으면 부팅 중 죽는다
# (경고가 아니라 TypeError / KafkaJSNonRetriableError). kafka 가 «먼저» 떠 있어야 한다.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID_PREFIX=membership
KAFKA_GROUP_ID=membership-local

# 로컬 IdP. 라이브(https://user.almondyoung.com)를 가리키면 로컬 서명 키(kid=lcnine-auth-local-1)를
# JWKS 에서 못 찾아 모든 어드민 API 가 401 이 된다 — core 에서 실제로 밟았던 사고다.
OIDC_ISSUER_URL=http://localhost:3000

# channel-adapter 의 MEMBERSHIP_INTERNAL_KEY 와 «같은 값»이어야 한다.
MEMBERSHIP_INTERNAL_KEY=local-membership-internal-key
