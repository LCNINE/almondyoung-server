# 쿠폰 개통 리허설 1차 — 로컬 스택. 절차: docs/coupon-rehearsal-local-env.md
# .env.template 은 almondyoung-next.com(구 도메인) + USE_RAILWAY_BACKEND=true 라 그대로 쓰면 안 된다.
# false 로 두면 lib/config/backend.ts 의 LOCAL_SERVICE_URLS 가 쓰여 전부 localhost 로 간다.
NEXT_PUBLIC_USE_RAILWAY_BACKEND=false
USE_RAILWAY_BACKEND=false

# 🔴 이 값은 «머신마다 다르다». Medusa DB 를 밀고 다시 시드하면 새 키가 발급되고, 옛 키를 쓰면
# Store API 가 401 인데 화면은 「상품이 없습니다」로만 보인다(2026-09-06 실측).
# 시드 직후 반드시: npm run sync:medusa-keys:local   ← DB 에서 읽어 이 파일에 박아 준다.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_시드후_sync:medusa-keys:local_로_채운다
NEXT_PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_REGION=kr
REVALIDATE_SECRET=supersecret

# 로컬 IdP. authEnv 가 required() 로 읽으므로 값이 없으면 500.
USER_SERVICE_URL=http://localhost:3000
AUTH_WEB_ORIGIN=http://localhost:8001
OIDC_ISSUER_URL=http://localhost:3000
OIDC_CLIENT_ID=medusa-storefront
OIDC_CLIENT_SECRET=local-rehearsal-medusa-storefront-secret

# localhost 는 부모 도메인 쿠키를 쓸 수 없다. 비워두면 host-only 쿠키로 떨어진다.
PARENT_COOKIE_DOMAIN=
PARENT_COOKIE_SECURE=false
PARENT_COOKIE_SAMESITE=lax

NEXT_PUBLIC_WALLET_WEB_URL=http://localhost:3200
