DATABASE_URL=

KAFKA_BROKERS="${{shared.KAFKA_BROKERS}}"
KAFKA_API_KEY="${{shared.KAFKA_API_KEY}}"
KAFKA_API_SECRET="${{shared.KAFKA_API_SECRET}}"
KAFKA_CLIENT_ID_PREFIX="notification"
KAFKA_GROUP_ID="notification-group"

RAILWAY_DOCKERFILE_PATH="apps/notification/Dockerfile"

OTEL_SERVICE_NAME=notification
OTEL_EXPORTER_OTLP_ENDPOINT=

# 출결 Web Push 내부 API 의 수신 키. user-service 의 값과 일치시킨다.
NOTIFICATION_INTERNAL_KEY=
# 같은 VAPID 키 쌍을 유지한다. 개인 키는 서버 비밀 저장소에서만 관리한다.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:push-operator@example.com
