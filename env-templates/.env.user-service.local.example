# 로컬 전체 스택용 user-service. 절차: docs/local-dev.md
# 템플릿: env-templates/.env.user-service.local.example
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/user_service
# main.ts 는 PORT 를 읽는다 (process.env.PORT ?? 3030). env.validation 의
# USER_SERVICE_PORT 는 검증만 하고 아무도 안 읽는다 — docs/local-dev.md 포트표(3000)에 맞춘다.
PORT=3000
USER_SERVICE_PORT=3000
NODE_ENV=development

# CORS — storefront(8000) · auth-web(8001) · admin-web(8002) · medusa(9000)
CORS_ORIGIN_DOMAINS=http://localhost:8000,http://localhost:8001,http://localhost:8002,http://localhost:9000,http://localhost:3200

AUTH_SECRET=local-auth-secret-do-not-use-anywhere-else
JWT_VERIFICATION_TOKEN_SECRET=local-verification-secret
JWT_REFRESH_SECRET=local-refresh-secret

# env.validation 이 required 로 잡지만 로컬에선 S3 를 실제로 안 쓴다.
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=almondyoung-local-unused

# OAuth IdP (RS256). base64 PEM — env.validation 의 pemString 이 디코드한다.
OAUTH_JWT_PRIVATE_KEY=<base64 PEM — scripts/local/gen-oauth-keys.sh 로 생성>
OAUTH_JWT_PUBLIC_KEY=<base64 PEM — scripts/local/gen-oauth-keys.sh 로 생성>
OAUTH_JWT_KID=lcnine-auth-local-1
OAUTH_ISSUER_URL=http://localhost:3000
OIDC_ISSUER_URL=http://localhost:3000
# user-service 에는 /oauth/authorize 가 없다 — auth-web 이 호스팅하고 discovery 가 이 값을 광고한다.
AUTH_WEB_ORIGIN=http://localhost:8001
# auth-web → user-service /oauth/internal/issue-code 공유 시크릿. 양쪽 값이 같아야 한다.
OAUTH_INTERNAL_SECRET=local-oauth-internal-secret
USER_SERVICE_INTERNAL_KEY=local-user-service-internal-key

# Kafka — "설정되지 않아 Kafka를 사용하지 않습니다" 경고가 뜬 뒤에도 EventsModule.forApp 이
# kafka.clientId 를 역참조해 부팅이 죽는다. 즉 이 값은 선택이 아니다. 루트 compose 브로커로 격리.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID_PREFIX=user-service-local
KAFKA_GROUP_ID=user-service-consumer-local
