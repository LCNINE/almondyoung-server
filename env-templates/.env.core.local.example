# 로컬 core 단독 개발용 템플릿. apps/core/.env 로 복사해 <> 부분을 채운다.
# 설계: docs/superpowers/specs/2026-07-23-local-core-dev-environment-design.md

PORT=3100
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev_core

# 로컬 compose 브로커. API 키를 넣지 않아 라이브 Confluent 접속 자체가 불가능하다.
# 브로커가 없으면 core 는 부팅하지 않는다 — 끄는 게 아니라 격리하는 것이다.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID_PREFIX=core-local
# core 는 현재 이 값을 읽지 않는다 — main.ts/sales-order.module.ts 가 컨슈머 groupId 를
# 'almondyoung-order-consumer' 로 하드코딩한다(라이브도 동일). 여기 채워도 반영되지 않으니
# 격리 목적으로 의존하지 말 것 — 실질 방어선은 KAFKA_API_KEY/SECRET 미설정뿐이다.
KAFKA_GROUP_ID=core-local-<사용자>

FULFILLMENT_WORKFLOW_MODE=v2
FULFILLMENT_V2_CUTOVER_AT=1970-01-01T00:00:00.000Z

# 🔴 로컬은 «로컬» IdP 를 봐야 한다. libs/authorization 이 이 값으로
# ${OIDC_ISSUER_URL}/.well-known/jwks.json 을 만들어 토큰 서명을 검증하는데, 라이브 JWKS 엔
# 로컬 user-service 가 쓰는 kid(lcnine-auth-local-1)가 없다 → core 의 어드민 API 가 «전부» 401.
# 화면은 그걸 「총 주문 0건」으로 그려서 조용하다 (docs/local-e2e-environment.md §4).
OIDC_ISSUER_URL=http://localhost:3000
AUTH_SECRET=<로컬 전용 임의값 — generate:token 으로 HS256 디버그 토큰 발급용>

# 아래는 의도적으로 비운다 (라이브 부작용 차단):
# WALLET_BASE_URL / WALLET_API_KEY / FILE_SERVICE_URL / HANJIN_* / ELASTICSEARCH_*

# 서비스 간 내부 호출 키. channel-adapter 의 같은 이름 값과 «반드시» 일치해야 한다.
# 없으면 channel-adapter 의 주문 수집이 매 주기 통째로 건너뛴다 —
# 「활성 판매채널 조회에 실패해 … 건너뛴다」 로그 한 줄로만 드러난다.
CORE_INTERNAL_KEY=<로컬 전용 임의값 — channel-adapter 와 같은 값>

# 상품 이미지. file-service 는 3010 이다 — channel-adapter 와 포트가 겹치지 않게 할 것(§3).
FILE_SERVICE_URL=http://localhost:3010
