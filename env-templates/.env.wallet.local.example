# 로컬 전체 스택용 wallet (:5001). 절차: docs/local-dev.md
# PG 자격증명(NICEPAY_*/TOSS_*)은 전부 optional 이라 없어도 부팅한다.
# 외부 PG 없이 주문을 완결하려면 ledger provider 인 POINTS 로 결제한다.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wallet
PORT=5001
NODE_ENV=development
SERVICE_NAME=wallet

# medusa 의 WALLET_API_KEY 와 같은 값이어야 한다 (almond-payment provider 가 이 키로 부른다).
WALLET_API_KEY=dev-secret

# dual-mode: HS256(USER_JWT_SECRET) 또는 RS256(OIDC_ISSUER_URL). 로컬 user-service 는 RS256 이므로
# OIDC 를 쓰되, env.validation 이 USER_JWT_SECRET 을 required 로 잡아 자리채움을 함께 둔다.
USER_JWT_SECRET=local-auth-secret-do-not-use-anywhere-else
OIDC_ISSUER_URL=http://localhost:3000
USER_SERVICE_URL=http://localhost:3000
USER_SERVICE_INTERNAL_KEY=local-user-service-internal-key

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=wallet-local
KAFKA_GROUP_ID=wallet-consumer-local
