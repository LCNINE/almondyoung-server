{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "os:default",
    "deep-link:default",
    "opener:default",
    "stronghold:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://user.almondyoung.com/*" },
        { "url": "https://core.almondyoung.com/*" }
      ]
    }
  ]
}
