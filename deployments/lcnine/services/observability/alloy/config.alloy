// 옛 스크레이프 설정이 target map 에 직접 찍던 두 라벨을 복원한다.
// service_name 은 Tempo·Loki 의 같은 이름 라벨과 조인하는 데 쓰이고,
// deployment_environment 는 stage 구분이다. 옛 설정에서 service_name 값은
// 항상 job 과 같았으므로 여기서 job 을 복사한다.
prometheus.relabel "service_labels" {
	forward_to = [prometheus.remote_write.grafanacloud.receiver]

	rule {
		source_labels = ["job"]
		target_label  = "service_name"
	}

	rule {
		target_label = "deployment_environment"
		replacement  = sys.env("SST_STAGE")
	}
}

prometheus.remote_write "grafanacloud" {
	endpoint {
		url = sys.env("GRAFANA_CLOUD_PROMETHEUS_REMOTE_WRITE_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_PROMETHEUS_USERNAME")
			password = sys.env("GRAFANA_CLOUD_API_TOKEN")
		}
	}
}
