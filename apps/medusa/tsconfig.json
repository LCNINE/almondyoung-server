{
  "compilerOptions": {
    "target": "ES2021",
    "esModuleInterop": true,
    "module": "Node16",
    "moduleResolution": "node16",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "inlineSourceMap": true,
    "outDir": "./.medusa/server",
    "rootDir": "../../",
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "checkJs": false,
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@packages/*": ["../../packages/*"]
    }
  },
  "ts-node": {
    "swc": true
  },
  "include": ["src/**/*", "../../packages/**/*"],
  // email-layout 은 ESM 전용 marked 를 쓴다. Medusa 는 이 패키지를 쓰지 않는데,
  // 포함하면 CommonJS 빌드가 TS1479 로 죽는다.
  "exclude": ["node_modules", "dist", "../../packages/email-layout/**"]
}
