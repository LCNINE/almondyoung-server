AUTH_SECRET="${{shared.AUTH_SECRET}}"

DATABASE_URL=postgresql://neondb_owner:npg_LHkhvM7jq6pa@ep-billowing-band-a1cgr277-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

KAFKA_API_KEY="${{shared.KAFKA_API_KEY}}"
KAFKA_API_SECRET="${{shared.KAFKA_API_SECRET}}"
KAFKA_BROKERS="${{shared.KAFKA_BROKERS}}"
KAFKA_CLIENT_ID_PREFIX="wms"
KAFKA_GROUP_ID="wms-group"

# Fulfillment hard-cutover gate. Production must set an explicit mode.
# maintenance | v2 ("legacy" was removed with the V1 outbound path). Required — there is no default.
FULFILLMENT_WORKFLOW_MODE="v2"
# Required when FULFILLMENT_WORKFLOW_MODE=v2 (ISO-8601). Only orders created at/after this
# instant get a fulfillment order. Epoch here means "every local order counts" — production
# sets a real, immutable cutover instant instead.
FULFILLMENT_V2_CUTOVER_AT="1970-01-01T00:00:00.000Z"

RAILWAY_DOCKERFILE_PATH="apps/wms/Dockerfile"

PORT=3005
