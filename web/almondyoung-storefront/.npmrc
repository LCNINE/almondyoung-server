registry=https://registry.npmjs.org/

# vitest 4 는 vite 8 을, vite 는 @types/node>=18 을 peer 로 요구한다.
# 이 프로젝트는 @medusajs/types 가 vite^5 를, package.json 이 @types/node@17 을 고정한다.
# 셋 다 peerOptional 이라 실제 런타임 의존성에는 영향이 없어 legacy 해석을 쓴다.
# 이게 없으면 npm ci 가 ERESOLVE 로 실패한다 (vitest 도입으로 생긴 제약).
legacy-peer-deps=true
