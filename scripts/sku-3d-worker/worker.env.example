# 3D 작업실 홈 PC 워커 설정 — 비밀값 없음. 이 파일을 저장소 밖(예: <hostRoot>/config/worker.env)에 복사해 채운다.
# 워커 키는 여기에 적지 않는다. new-key.mjs 가 만든 worker-key.env 에만 있다.

# 서버 주소. 운영은 https://core.almondyoung.com, 개발 검증 때는 그때 띄운 임시 터널 주소(로그에 임시 개발 연결 로 표시된다)
SKU3D_SERVER_URL=
# 테넌트 id. 값은 lcnine-auth 의 테넌트 목록(SSM /lcnine-auth/<stage>/tenant-list)에서 확인한다
SKU3D_TENANT_ID=
SKU3D_HOST_ID=almond-3d-windows-01

# 작업 폴더 — 작업실마다 하위 폴더가 생긴다 (준비 파일 jobRoot)
SKU3D_WORK_ROOT=C:/Users/hello/Documents/Codex/2026-11-25/new-chat/work/almond-3d-host/jobs

# 도구 경로 (준비 파일 codexExecutable / blenderExecutable / nodeExecutable / gltfTransformCli)
CODEX_BIN=C:/Users/hello/AppData/Local/Microsoft/WinGet/Packages/OpenAI.Codex_Microsoft.Winget.Source_8wekyb3d8bbwe/codex-x86_64-pc-windows-msvc.exe
BLENDER_PATH=C:/Users/hello/Documents/Codex/2026-11-25/new-chat/work/almond-3d-host/runtime/blender-5.2.5-windows-x64/blender.exe
NODE_BIN=C:/Users/hello/AppData/Local/Programs/nodejs22/node-v22.23.4-win-x64/node.exe
GLTF_TRANSFORM_CLI=C:/Users/hello/Documents/Codex/2026-11-25/new-chat/work/almond-3d-host/node_modules/@gltf-transform/cli/bin/cli.js
# gltf-validator 패키지 폴더(CLI 가 아니라 require 할 모듈 경로)
GLTF_VALIDATOR_MODULE=C:/Users/hello/Documents/Codex/2026-11-25/new-chat/work/almond-3d-host/node_modules/gltf-validator
# 압축 GLB 를 실제 웹 뷰어로 확인할 때 쓰는 Edge
EDGE_BIN=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe

# 격리 — 워커 전용 Codex 홈(평소 쓰는 ~/.codex 와 따로). 처음 한 번 이 홈으로 로그인한다:
#   $env:CODEX_HOME = '<이 경로>'; & $env:CODEX_BIN login --device-auth
SKU3D_CODEX_HOME=C:/Users/hello/Documents/Codex/2026-11-25/new-chat/work/almond-3d-host/codex-home
# Codex 가 띄우는 명령이 읽지 못하게 막을 경로(; 로 구분). 설정·키 폴더는 반드시 넣는다.
# 다른 작업실 폴더·SKU3D_CODEX_HOME·사용자 ~/.codex 는 워커가 알아서 막는다
SKU3D_DENY_READ=C:/Users/hello/Documents/Codex/2026-11-25/new-chat/work/almond-3d-host/config
# Windows 샌드박스 구현. unelevated 는 읽기 차단이 안 된다 — mxc(권장) 또는 elevated(관리자 설정 필요)
SKU3D_WINDOWS_SANDBOX=mxc

# 동시 생성 수(처음엔 1), 대기 작업 확인 간격, 작업 하나의 제한 시간(분)
SKU3D_CONCURRENCY=1
SKU3D_POLL_MS=5000
SKU3D_JOB_TIMEOUT_MIN=60
